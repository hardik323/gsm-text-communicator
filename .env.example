# Copy to .env and fill in. Never commit .env.

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=

# --- Spam guard -------------------------------------------------------------
# How many wrong commands are tolerated inside the window...
MAX_WRONG=3
# ...how long that window is, in seconds...
WRONG_WINDOW_SECONDS=60
# ...and how long the chat is ignored once it goes over, in seconds.
BLOCK_SECONDS=60

# --- Command rules ----------------------------------------------------------
# Digits accepted in a /location number (7..15 = the E.164 range).
MIN_DIGITS=7
MAX_DIGITS=15

# --- PostgreSQL (Prisma) ----------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/geopulse_official_bot?schema=public"

# --- Redis pub/sub ----------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"
# Channel that new requests are announced on.
REDIS_CHANNEL="LocationRequests"

# --- Dashboard (bun dashboard.js) -------------------------------------------
# Local-only web UI. Keep the host at 127.0.0.1: it has no authentication.
DASHBOARD_HOST="127.0.0.1"
DASHBOARD_PORT=3000

# --- SMS Gateway for Android ------------------------------------------------
# Free, open-source gateway app on an Android phone with a SIM. Username +
# password come from the app's Home tab. The phone's own number is the sender;
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Cloud: https://api.sms-gate.app — local phone: http://<device_ip>:8080.
SMS_GATEWAY_BASE_URL="https://api.sms-gate.app"
# The receiver of the lookup SMS: the nodal number the query goes to.
NODAL_NUMBER=
# Optional: 1-based SIM slot (1..3) when the phone is dual-SIM.
SMS_SIM_NUMBER=
# Optional: gateway device id when more than one device is linked.
SMS_DEVICE_ID=
# Nodal receivers are service codes, not E.164 numbers, so skip validation.
SMS_SKIP_PHONE_VALIDATION=true

# --- Webhook receiver (bun webhook) -----------------------------------------
# Listens for texts arriving at the gateway phone, republishes them on the
# MessagesReceived channel. The phone reaches it through WEBHOOK_URL only,
# so bind a normal address if you tunnel the port to the internet.
WEBHOOK_HOST="127.0.0.1"
WEBHOOK_PORT=3001
# Public HTTPS URL of the receiver, e.g. https://…/webhook (tunnel). Set it
# and `bun webhook` registers it with the gateway on startup.
WEBHOOK_URL=
# Channel that received texts are published on.
REDIS_MESSAGE_CHANNEL="MessagesReceived"

# --- Telecom operator detection (API Express) -------------------------------
# Bearer key, from https://apiexpress.in/signup. programme.js asks it which
# carrier owns a query number and stores the answer in locationRequests.TSP;
# the lookup SMS then goes to that carrier's nodal number and is formatted
# with its RequestFormat from the Tsp table. Without a key nothing is sent.
APIEXPRESS_API_KEY=
# Endpoint (default https://api.apiexpress.in/v1/telecom/operator).
APIEXPRESS_URL=
# How long to wait for the answer, in milliseconds (default 8000).
APIEXPRESS_TIMEOUT_MS=

# --- Location reply timeout --------------------------------------------------
# A request whose location reply does not arrive within this many minutes is
# marked NODAL_RESPONSE_TIMEOUT (default 15). An operator lookup that never
# returns is marked FAILED after one sweep interval, so the sweep must be
# much shorter than the reply timeout below.
NODAL_RESPONSE_TIMEOUT_MINUTES=15
NODAL_SWEEP_MS=30000
