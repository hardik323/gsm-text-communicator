# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# SMS backend: "smsgate" (recommended, nothing to build) or "local" (bundled app)
SMS_PROVIDER=smsgate

# --- smsgate backend: free "SMS Gateway for Android" app in Local Server mode ---
# Exactly as shown in the app, e.g. http://192.168.31.50:8080
SMSGATE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# How often to read the phone's inbox for the reply SMS (seconds)
SMSGATE_POLL_SECONDS=5

# --- local backend (bundled android-gateway app) ---
# The SIM inside the Android gateway phone (the one that sends the SMS)
GATEWAY_SIM_SENDER_NUMBER=

# Shared secret between the bot and the Android app. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_TOKEN=

# HTTP API the phone polls
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# --- shared by both backends ---
# The device that answers "/location {number}" (replies arrive from this number)
GATEWAY_SIM_DESTINATION_NUMBER=

# How long to wait for the reply SMS (minutes)
RESPONSE_TIMEOUT_MINUTES=5

# local backend only: how long a claimed SMS stays reserved before re-queueing (seconds)
CLAIM_LEASE_SECONDS=60

# local backend only: send attempts before a request is marked failed
SEND_MAX_ATTEMPTS=3

# Where pending requests are persisted
DATA_FILE=data/state.json
