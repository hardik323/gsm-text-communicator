// Prisma schema — model first.
// Database: PostgreSQL, database name "geopulse_official_bot".
//
// Table/column names deliberately match the agreed spec (camelCase), so in raw
// SQL they must be quoted. Prisma generates the quoting for you.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every /location request a user makes.
///
/// Status codes:
///   1 = created             request accepted from Telegram
///   2 = TspRequested        sent to the TSP / carrier
///   3 = TspFound            carrier located
///   4 = TspNotFound         carrier could not be located
///   5 = locationRequested   location lookup started
///   6 = NodalResponseFound  nodal reply received
///   7 = NodalResponseTimeout nodal reply did not arrive
///   8 = FAILED               processing failed (terminal)
model locationRequests {
  /// Surrogate key: a request's status changes many times, so it needs an
  /// immutable identifier that is independent of who asked and for what.
  Id String @id @default(uuid()) @db.Uuid

  /// Telegram user id (from.id). BIGINT: ids are already past 2^31.
  UserId BigInt

  /// Telegram chat id (chat.id). Negative for groups, so it must be signed.
  ChatId BigInt

  /// The number being located, digits with optional leading "+" (max E.164).
  QueryNumber String @db.VarChar(16)

  /// Telecom service provider / carrier that answered.
  TSP String? @db.VarChar(100)

  /// Raw reply from the nodal lookup.
  NodalResponse String? @db.Text

  /// The structured reply we sent back to Telegram, in case it needs keeping.
  Response String? @db.Text

  /// Human notes and exceptions: operator lookup failures, SMS send errors,
  /// mismatched replies, and so on. Not shown to the user by default.
  Comments String? @db.Text

  /// 1..8, see the status list above. Enforced by a CHECK constraint.
  Status Int @default(1)

  CreatedDateTime DateTime @default(now()) @db.Timestamptz(3)

  LastStatusChangeDateTime DateTime @default(now()) @db.Timestamptz(3)

  /// Replies are matched per chat, newest first.
  @@index([ChatId, CreatedDateTime])

  /// "How many times did this user ask for this number?" / abuse checks.
  @@index([UserId, CreatedDateTime])

  /// Lookups by the queried number itself.
  @@index([QueryNumber])

  /// The background worker scans open requests by status.
  @@index([Status, CreatedDateTime])

  @@map("locationRequests")
}

/// Telecommunications service providers the SMS Gateway phone can query.
///
/// `NodalNumber` is the short code the lookup SMS is sent to. It is stored
/// exactly as given, spaces included (e.g. "070212 65165"); the gateway strips
/// them when calling its API. `RequestFormat` is a column, not a constant,
/// because each provider has its own template — Airtel/JIO use
/// `91{query_number}`, Idea uses `CELL 91{query_number}` and BSNL uses
/// `Getloc 91****` (which masks the number). `IsActive` retires a provider
/// without deleting it.
model Tsp {
  Id           String  @id @default(uuid()) @db.Uuid
  Provider     String  @unique @db.VarChar(50)
  NodalNumber  String  @db.VarChar(32)
  RequestFormat String @default("91{query_number}") @db.VarChar(64)
  IsActive     Boolean @default(true)

  CreatedDateTime          DateTime @default(now()) @db.Timestamptz(3)
  LastStatusChangeDateTime DateTime @default(now()) @db.Timestamptz(3)

  @@index([IsActive])
  @@map("Tsp")
}

/// People who can log into the dashboard.
///
/// `PasswordHash` is a bcrypt hash of the user's password. `Role` controls
/// what the dashboard shows: right now the only non-admin role is `viewer`,
/// which gets a read-only copy of the same dashboard but no admin tooling.
model User {
  Id           String  @id @default(uuid()) @db.Uuid
  Username     String  @unique @db.VarChar(64)
  PasswordHash String  @db.VarChar(128)
  Role         String  @default("viewer") @db.VarChar(20)

  CreatedDateTime          DateTime @default(now()) @db.Timestamptz(3)
  LastChangedDateTime      DateTime @default(now()) @db.Timestamptz(3)

  @@map("users")
}
